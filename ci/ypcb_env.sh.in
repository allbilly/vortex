#!/usr/bin/env bash
set -euo pipefail

if [[ ${BASH_SOURCE[0]} == "${VORTEX_YPCB_SNAPSHOT_PATH:-}" \
   && $$ == "${VORTEX_YPCB_SNAPSHOT_OWNER:-}" \
   && ${BASH_SOURCE[0]##*/} == vortex-ypcb-env.*.sh ]]; then
    ypcb_snapshot=${BASH_SOURCE[0]}
    trap 'rm -f -- "$ypcb_snapshot"' EXIT
else
    ypcb_snapshot=$(mktemp "${TMPDIR:-/tmp}/vortex-ypcb-env.XXXXXXXX.sh")
    cp -- "${BASH_SOURCE[0]}" "$ypcb_snapshot"
    exec env VORTEX_YPCB_SNAPSHOT_PATH="$ypcb_snapshot" \
        VORTEX_YPCB_SNAPSHOT_OWNER="$$" bash "$ypcb_snapshot" "$@"
fi

source_dir='@VORTEX_HOME@'
build_dir='@BUILDDIR@'
tool_dir='@TOOLDIR@'
native_exec() {
    if [[ ! -x "$build_dir/.venv/bin/python" ]]; then
        printf '%s\n' 'Run ./ci/ypcb_env.sh setup to create the uv environment.' >&2
        return 1
    fi
    local worker_count=${THREADS:-$(getconf _NPROCESSORS_ONLN)}
    local -a environment=("PATH=$build_dir/.venv/bin:$tool_dir/verilator/bin:$PATH"
                          "CONFIGS=${CONFIGS:-}" "THREADS=$worker_count")
    local include_paths=${CPLUS_INCLUDE_PATH:-}
    local library_paths=${LIBRARY_PATH:-}
    for dependency in uuid libpng; do
        if pkg-config --exists "$dependency"; then
            local prefix
            prefix=$(pkg-config --variable=prefix "$dependency")
            include_paths="$prefix/include${include_paths:+:$include_paths}"
            library_paths="$prefix/lib${library_paths:+:$library_paths}"
        fi
    done
    environment+=("CPLUS_INCLUDE_PATH=$include_paths" "C_INCLUDE_PATH=$include_paths"
                  "LIBRARY_PATH=$library_paths")
    env "${environment[@]}" "$@"
}

case ${1:-help} in
    setup)
        for dependency in uv ccache g++ make pkg-config; do
            command -v "$dependency" >/dev/null || { printf 'Missing dependency: %s\n' "$dependency" >&2; exit 1; }
        done
        mkdir -p "$tool_dir"
        if [[ ! -x "$build_dir/.venv/bin/python" ]]; then
            uv venv --python python3 "$build_dir/.venv"
        fi
        uv pip install --python "$build_dir/.venv/bin/python" pytest PyYAML packaging pyserial colorama requests 'cmake>=3.14,<4' 'pythondata-cpu-vexriscv==1.0.1.post407'
        native_exec git -C "$source_dir" submodule update --init --recursive
        ;;
    exec)
        shift
        native_exec "$@"
        ;;
    configure)
        selected_profile=${PROFILE:-}
        if [[ -z $selected_profile && -f "$build_dir/config.mk" ]]; then
            selected_profile=$(sed -n 's/^[[:space:]]*PROFILE[[:space:]]*?=[[:space:]]*//p' "$build_dir/config.mk" | head -n 1)
            selected_profile=${selected_profile//[@[:space:]]/}
        fi
        memory_size=2147483648
        if [[ $selected_profile == ypcb_blackwell_like_4gb ]]; then
            memory_size=4294967296
        fi
        configure_args=(--xlen=32 --memory-size="$memory_size" --tooldir="$tool_dir" --osversion=ubuntu/focal)
        if [[ -n $selected_profile ]]; then
            configure_args+=(--profile="$selected_profile")
        fi
        native_exec "$source_dir/configure" "${configure_args[@]}"
        ;;
    install-toolchain)
        flags=()
        for pair in llvm:llvm-vortex libcrt32:libcrt32 libc32:libc32 \
            riscv32:riscv32-gnu-toolchain verilator:verilator pocl:pocl sv2v:sv2v; do
            if [[ ! -d "$tool_dir/${pair#*:}" ]]; then
                flags+=("--${pair%%:*}")
            fi
        done
        if ((${#flags[@]})); then
            native_exec ./ci/toolchain_install.sh "${flags[@]}"
        fi
        ;;
    open-setup)
        native_exec bash -c 'set -euo pipefail
            mkdir -p open-reference
            while read -r name url revision; do
                path="open-reference/$name"
                if [[ ! -d "$path" ]]; then
                    git init "$path"
                    git -C "$path" remote add origin "$url"
                    git -C "$path" fetch --depth=1 origin "$revision"
                    git -C "$path" checkout --detach FETCH_HEAD
                fi
                [[ $(git -C "$path" rev-parse HEAD) == "$revision" ]]
                [[ -z $(git -C "$path" status --porcelain --untracked-files=no) ]]
            done <<PINS
migen https://github.com/m-labs/migen.git e19524c963a8342952840983047557707fbe0b6a
litex https://github.com/enjoy-digital/litex.git 8c01073afb71aa0a0709f02f8e24247589e8f5e4
litedram https://github.com/enjoy-digital/litedram.git 74522f715d7b10163ef6f6caa09887a90874be83
litex-boards https://github.com/litex-hub/litex-boards.git 10debf146d433ce8ac8aedcac84e97d252ff4d5b
pcie_7x https://github.com/regymm/pcie_7x.git cd1c33f53401d6ce1b6ec35da17884455477c2e9
PINS
'
        ;;
    smoke|smoke-xrt)
        driver=simx
        [[ $1 != smoke-xrt ]] || driver=xrt
        bash "$0" configure
        if [[ -z ${CONFIGS:-} ]]; then
            CONFIGS=$(native_exec make --no-print-directory -s -C hw/syn/xilinx/ypcb print-configs)
        fi
        export CONFIGS STARTUP_ADDR=0x40000000
        native_exec cmake -S "$source_dir/third_party/ramulator" -B "$build_dir/third_party/ramulator"
        native_exec python3 "$source_dir/ci/patch_ramulator_deps.py" "$source_dir/third_party/ramulator"
        native_exec cmake --build "$build_dir/third_party/ramulator" --parallel 1
        native_exec make -j1 -C "$source_dir/third_party"
        native_exec make -C sw/kernel clean
        native_exec make -j1 -C sw/kernel
        native_exec make -C sw/runtime/stub clean
        native_exec make -j1 -C sw/runtime/stub
        native_exec make -j1 -C "sw/runtime/$driver"
        native_exec make -C tests/regression/demo clean
        native_exec make -C tests/regression/demo
        native_exec timeout 600 ./ci/blackbox.sh --driver="$driver" --app=demo
        native_exec make -C tests/regression/sgemm clean
        native_exec make -C tests/regression/sgemm
        native_exec timeout 600 ./ci/blackbox.sh --driver="$driver" --app=sgemm --args=-n16
        ;;
    stage-reference|preflight|inventory)
        python3 "$source_dir/ci/ypcb_prepare.py" "$1" --build "$build_dir" "${@:2}"
        ;;
    *)
        printf '%s\n' 'Usage: ./ci/ypcb_env.sh {setup|configure|install-toolchain|open-setup|smoke|smoke-xrt|exec COMMAND...|stage-reference|preflight|inventory}'
        exit 1
        ;;
esac
