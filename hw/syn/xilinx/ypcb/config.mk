YPCB_CONFIGS := -DVX_CFG_FPU_TYPE=STD -DVX_CFG_PLATFORM_CLOCK_RATE=125
# Keep one linear AFU port; dual-channel routing splits its 4 GiB aperture in the board bridge.
ifeq ($(MEMORY_SIZE),2147483648)
YPCB_MEMORY_ADDR_WIDTH := 31
YPCB_DUAL_CHANNEL_FLAG := -DVX_CFG_YPCB_DUAL_CHANNEL_DISABLE
ifeq ($(PROFILE),ypcb_blackwell_like_4gb)
$(error PROFILE=ypcb_blackwell_like_4gb requires MEMORY_SIZE=4294967296)
endif
else ifeq ($(MEMORY_SIZE),4294967296)
YPCB_MEMORY_ADDR_WIDTH := 32
YPCB_DUAL_CHANNEL_FLAG := -DVX_CFG_YPCB_DUAL_CHANNEL_ENABLE
ifneq ($(PROFILE),ypcb_blackwell_like_4gb)
$(error MEMORY_SIZE=4294967296 requires PROFILE=ypcb_blackwell_like_4gb)
endif
else
$(error YPCB supports only MEMORY_SIZE=2147483648 or 4294967296)
endif
YPCB_CONFIGS += -DVX_CFG_PLATFORM_MEMORY_NUM_BANKS=1 \
	-DVX_CFG_PLATFORM_MEMORY_ADDR_WIDTH=$(YPCB_MEMORY_ADDR_WIDTH) \
	-DVX_CFG_MEM_ADDR_WIDTH=$(YPCB_MEMORY_ADDR_WIDTH) \
	$(YPCB_DUAL_CHANNEL_FLAG)
YPCB_CONFIGS += -DVX_CFG_PLATFORM_MEMORY_PEAK_BW=6400
YPCB_STARTUP_ADDR := 0x40000000
